/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "AltF4; dosyaları taşımak, öğeleri Çöp Sepeti’ne göndermek, istenen komutları açmak ve medya uygulamalarınızda oynatmayı denetlemek için Otomasyon kullanır.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "AltF4, mikserde ses düzeyini ayarlamak, Dynamic Island'ın müzik çubuklarını hareket ettirmek ve başlattığın ekran kayıtlarına Mac'in sesini eklemek için her uygulamanın sesini kullanır. Hiçbir şey Mac'inden çıkmaz.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "AltF4, Bluetooth'u yalnızca bağlı çevre birimlerinin pil düzeyini okumak için kullanır. Hiçbir veri Mac'inden çıkmaz.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "AltF4, mikrofonunuzu yalnızca ekran kaydı için açtığınızda kaydeder. Geçici bir bağlantı oluşturmadığınız sürece ses Mac'inizde kalır.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "AltF4, kameranızı yalnızca açtığınız önizleme penceresinde gösterir; böylece aramadan önce nasıl göründüğünüzü kontrol edebilirsiniz. Hiçbir şey kaydedilmez veya Mac'inizden çıkmaz.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "AltF4, yalnızca seçtiğiniz doğrulanmış WhatsApp dosyalarını incelemek, düzenlemek veya Çöp Sepeti'ne taşımak için İndirilenler'deki yerel meta verileri denetler.";

/* macOS user-selected organizer destination prompts. */
